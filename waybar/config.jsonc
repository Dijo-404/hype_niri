{
  "layer": "top",
  "position": "top",
  "height": 44,
  "margin-top": 2,
  "margin-left": 2,
  "margin-right": 2,
  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/launcher",
    "group/cpu-group",
    "group/mem-group",
    "group/temp-group",
    "custom/caffeine",
    "custom/power-profile"
  ],
  "modules-center": ["niri/workspaces"],
  "modules-right": [
    "clock",
    "pulseaudio#microphone",
    "pulseaudio",
    "battery",
    "group/connectivity",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "~/.config/scripts/hype-control app-launcher"
  },

  "niri/workspaces": {
    "format": "{index}"
  },

  "custom/caffeine": {
    "exec": "~/.config/scripts/hype-control caffeine",
    "return-type": "json",
    "interval": "once",
    "format": "{}",
    "on-click": "~/.config/scripts/hype-control caffeine toggle",
    "signal": 15
  },
  "custom/power-profile": {
    "exec": "~/.config/scripts/hype-control power-profile",
    "return-type": "json",
    "interval": "once",
    "format": "{icon}",
    "format-icons": ["󰾆", "󰾅", "󰓅"],
    "on-click": "~/.config/scripts/hype-control power-profile menu",
    "signal": 16
  },

  "clock": {
    "interval": 30,
    "format": "<span line_height='0.8'>{:%H:%M<span size='1pt'>\n</span><span size='8.4pt' color='#aaaaaa'>%A, %d/%m</span>}</span>",
    "tooltip-format": "<big>{:%A, %B %d}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "group/cpu-group": {
    "orientation": "inherit",
    "modules": ["cpu", "custom/cpu-label"]
  },
  "custom/cpu-label": {
    "format": "cpu"
  },
  "cpu": {
    "interval": 3,
    "states": { "single-digit": 0, "multi-digit": 10 },
    "format": "{usage}%",
    "tooltip-format": "CPU load: {usage}%",
    "align": 0.5
  },

  "group/mem-group": {
    "orientation": "inherit",
    "modules": ["memory", "custom/mem-label"]
  },
  "custom/mem-label": {
    "format": "ram"
  },
  "memory": {
    "interval": 5,
    "format": "{used:0.0f}G",
    "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB used ({percentage}%)",
    "align": 0.5
  },
  "group/temp-group": {
    "orientation": "inherit",
    "modules": ["custom/temperature", "custom/temp-label"]
  },
  "custom/temp-label": {
    "format": "temp"
  },
  "custom/temperature": {
    "exec": "~/.config/scripts/hype-status temperature",
    "return-type": "json",
    "restart-interval": 5,
    "format": "{text}",
    "align": 0.5
  },

  "tray": {
    "icon-size": 15,
    "spacing": 5,
    "orders": { "nm-applet": -1 }
  },

  "group/connectivity": {
    "orientation": "horizontal",
    "modules": ["custom/hotspot", "tray"]
  },
  "custom/hotspot": {
    "exec": "~/.config/scripts/hype-status hotspot",
    "return-type": "json",
    "restart-interval": 5,
    "format": "{}",
    "on-click": "~/.config/scripts/hype-control hotspot toggle",
    "on-click-right": "~/.config/scripts/hype-control hotspot menu"
  },
  "custom/warp": {
    "exec": "~/.config/scripts/hype-control warp-indicator",
    "return-type": "json",
    "interval": 10,
    "format": "{}"
  },
  "image#stealth": {
    "exec": "~/.config/scripts/hype-control stealth-indicator",
    "interval": 10,
    "size": 15
  },

  "pulseaudio": {
    "smooth-scrolling-threshold": 1.0,
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%",
    "on-click": "~/.config/scripts/hype-control volume mute",
    "on-click-right": "~/.config/scripts/hype-control launch-default audio",
    "on-scroll-up": "~/.config/scripts/hype-control volume up",
    "on-scroll-down": "~/.config/scripts/hype-control volume down"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "on-click": "~/.config/scripts/hype-control mic mute",
    "tooltip": true,
    "tooltip-format": "{source_desc} | Volume: {source_volume}%"
  },

  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-alt": "{icon} {time}",
    "tooltip-format": "{capacity}% · {timeTo}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "custom/power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Power Menu",
    "on-click": "~/.config/scripts/hype-control power-menu",
    "on-click-right": "~/.config/scripts/hype-control power-menu"
  }
}
