include "outputs.kdl"

environment {
    XDG_SESSION_TYPE "wayland"
}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
    hide-when-typing
}

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
    }

    mouse {}

    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    gaps 4

    struts {
        left -2
        right -2
        top -2
        bottom -2
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        on
        width 2
        active-color "#b0b0b0"
        inactive-color "#404040"
    }

    shadow {
        on
        softness 3
        spread 1
        offset x=0 y=1
        color "#00000066"
    }
}

animations {
    workspace-switch {
        spring damping-ratio=0.90 stiffness=900 epsilon=0.0001
    }

    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-out-expo"
    }

    horizontal-view-movement {
        spring damping-ratio=0.90 stiffness=900 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.90 stiffness=900 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.9 stiffness=800 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=800 epsilon=0.001
    }
}

prefer-no-csd

screenshot-path "~/pictures/screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

include "opacity.kdl"

layer-rule {
    match namespace="^waybar$"
    geometry-corner-radius 6
    background-effect { blur true; }
}

window-rule {
    match app-id="^blueman-manager$"
    open-floating true
    default-column-width { fixed 595; }
    default-window-height { fixed 365; }
}

spawn-sh-at-startup "~/.config/scripts/start-waybar.sh"

spawn-sh-at-startup "~/.config/scripts/start-tray-applets.sh"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "mako"
spawn-at-startup "alacritty"

spawn-sh-at-startup "~/.config/scripts/wallpaper.sh init"
spawn-sh-at-startup "~/.config/scripts/display-scale.sh"

spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_ID NIRI_SOCKET; systemctl --user restart hypridle.service || hypridle"

spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"

binds {

    Mod+Q repeat=false { close-window; }
    Ctrl+Q repeat=false { close-window; }
    Alt+F4 repeat=false { close-window; }
    Mod+Delete { quit; }
    Mod+Shift+Delete { spawn-sh "~/.config/scripts/wallpaper.sh current; wlogout --protocol layer-shell -b 5 --margin-top 350 --margin-bottom 350 --margin-left 200 --margin-right 300 -l ~/.config/wlogout/layout -C ~/.config/wlogout/style.css"; }

    Mod+W { toggle-column-tabbed-display; }
    Mod+Shift+S repeat=false hotkey-overlay-title="Toggle Window Opacity" { spawn-sh "~/.config/scripts/opacity-toggle.sh"; }
    Mod+Shift+F { spawn-sh "~/.config/scripts/fullscreen-toggle.sh"; }
    Mod+F { maximize-column; }
    Mod+O repeat=false { toggle-overview; }
    Mod+L { spawn-sh "~/.config/scripts/lock-dim.sh"; }

    Mod+Space { toggle-window-floating; }
    Mod+Shift+Space { switch-focus-between-floating-and-tiling; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Alt+Tab   { focus-window-down; }

    Mod+Ctrl+Left  { set-column-width "-30"; }
    Mod+Ctrl+Right { set-column-width "+30"; }
    Mod+Ctrl+Up    { set-window-height "-30"; }
    Mod+Ctrl+Down  { set-window-height "+30"; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Alt+Shift+Left  { move-column-left; }
    Alt+Shift+Right { move-column-right; }
    Alt+Shift+Up    { move-window-up; }
    Alt+Shift+Down  { move-window-down; }

    Mod+T hotkey-overlay-title="Terminal: alacritty" { spawn "alacritty"; }
    Mod+E { spawn "nautilus" "-w"; }
    Mod+Shift+D hotkey-overlay-title="Display Refresh Rate" { spawn-sh "~/.config/scripts/monitor-refresh.sh"; }
    Mod+U { spawn-sh "~/.config/scripts/open-drives.sh"; }
    Mod+C { spawn-sh "alacritty -e nvim"; }
    Mod+Shift+F23 repeat=false allow-when-locked=true hotkey-overlay-title="Copilot: VS Code / double press: lock displays or show password prompt" { spawn-sh "~/.config/scripts/copilot-shortcut.sh"; }
    Mod+Shift+XF86TouchpadOff repeat=false allow-when-locked=true { spawn-sh "~/.config/scripts/copilot-shortcut.sh"; }
    Mod+F23 repeat=false allow-when-locked=true { spawn-sh "~/.config/scripts/copilot-shortcut.sh"; }
    Mod+XF86Assistant repeat=false allow-when-locked=true { spawn-sh "~/.config/scripts/copilot-shortcut.sh"; }
    Mod+B hotkey-overlay-title="Browser: Brave" { spawn "brave"; }
    Ctrl+Shift+Escape { spawn-sh "alacritty -e htop"; }

    Mod+A hotkey-overlay-title="App Launcher: fuzzel" { spawn "fuzzel"; }
    Mod+Tab { toggle-overview; }
    Mod+Period { spawn-sh "bemoji -t"; }
    Mod+V { spawn-sh "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Shift+C { center-column; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma { consume-window-into-column; }

    F10 allow-when-locked=true { spawn-sh "~/.config/scripts/volume-control.sh mute"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "~/.config/scripts/volume-control.sh mute"; }
    F11 allow-when-locked=true { spawn-sh "~/.config/scripts/volume-control.sh down"; }
    F12 allow-when-locked=true { spawn-sh "~/.config/scripts/volume-control.sh up"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "~/.config/scripts/mic-control.sh mute"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "~/.config/scripts/volume-control.sh down"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "~/.config/scripts/volume-control.sh up"; }

    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "~/.config/scripts/brightness-control.sh up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "~/.config/scripts/brightness-control.sh down"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Mod+Shift+P { spawn-sh "hyprpicker -a"; }

    Mod+Alt+Right { spawn-sh "~/.config/scripts/wallpaper.sh random"; }
    Mod+Alt+Left { spawn-sh "~/.config/scripts/wallpaper.sh random"; }
    Mod+Shift+W { spawn-sh "~/.config/scripts/wallpaper.sh select"; }

    Mod+Alt+Up { spawn-sh "pkill waybar; ~/.config/scripts/start-waybar.sh"; }
    Mod+Alt+Down { spawn-sh "pkill waybar"; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Alt+Left  { move-column-to-monitor-left; }
    Mod+Shift+Alt+Right { move-column-to-monitor-right; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    XF86PowerOff allow-when-locked=true { spawn-sh "~/.config/scripts/suspend-now.sh"; }
    XF86Sleep allow-when-locked=true { spawn-sh "~/.config/scripts/suspend-now.sh"; }
    XF86Suspend allow-when-locked=true { spawn-sh "~/.config/scripts/suspend-now.sh"; }
}
